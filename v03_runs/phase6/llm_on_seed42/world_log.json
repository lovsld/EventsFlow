    "event_id": "E0023",
    "tick": 6,
    "type": "ambient",
    "actors": [],
    "location": "bar",
    "topic": "candle_flickers",
    "text": "吧台的蜡烛晃了晃，老板的目光跟着晃了一下。"
   }
