    ],
    "location": "tables",
    "topic": "开库提货时间",
    "claim": null,
    "text": "客官辛苦。库房向来寅时开——明早天蒙蒙亮您来，我给您开门点货，赶船不耽误。今晚雨大路滑，您先歇着。",
    "interrupted": true,
    "session_location": "tables"
   },
